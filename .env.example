# ===========================================
# Firebase Configuration
# ===========================================
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_MEASUREMENT_ID=

# ===========================================
# Web3Forms Configuration
# ===========================================
# Required for both /contact submission flows.
# Use a real key locally for live validation. Do not commit secrets.
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=


# ===========================================
# Resend Configuration
# ===========================================
# Server-only subscription settings for Nuxt runtimeConfig.
# Subscribers are added directly to Resend contacts, then sent a welcome email.
# On the Cloudflare Worker target, configure these exact env var names.
# Use a real API key locally for live validation. Do not commit secrets.
# The API key needs contacts write access, not just email sending.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=noreply@subscribe.skill-wanderer.com
# Optional: Reply-To address for the welcome email, read at build time.
# The email asks people to reply to unsubscribe, so point this at a monitored inbox.
# Leave empty to omit Reply-To (replies then go to the from address).
NUXT_RESEND_REPLY_TO_EMAIL=
# Optional: Resend segment ID new contacts are added to.
# Leave empty to add contacts without assigning a segment.
NUXT_RESEND_SEGMENT_ID=

# ===========================================
# PayPal Configuration (JavaScript SDK v6)
# ===========================================
# Powers the "Donate with PayPal" option on /help-the-mission.
# Create a REST app at https://developer.paypal.com/dashboard/applications and copy
# its client ID and secret. Sandbox and live apps have different credentials.
# The client ID is public (it is sent to the browser). The secret is server-only.
# Required for donations: without a client ID, the page shows no donate button.
# On the Cloudflare Worker target, configure these exact env var names, and store
# the secret with: wrangler secret put NUXT_PAYPAL_CLIENT_SECRET
# Use real credentials locally for live validation. Do not commit secrets.
NUXT_PUBLIC_PAYPAL_CLIENT_ID=
NUXT_PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "production". Must match the app the credentials come from.
NUXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox
# Plan behind monthly donations. Create one per environment with the settings above:
#   npm run paypal:create-monthly-plan
# then paste the printed P-... ID here. Leave empty to offer one-time donations only.
NUXT_PUBLIC_PAYPAL_MONTHLY_PLAN_ID=

# ===========================================
# Pathfinder Chatbot Configuration
# ===========================================

# Pathfinder API base URL (no trailing slash)
# Local development:
NUXT_PUBLIC_PATHFINDER_API_URL=http://localhost:8000
# Production (set via NUXT_PUBLIC_PATHFINDER_API_URL env var or K8s secret):
# NUXT_PUBLIC_PATHFINDER_API_URL=https://pathfinder.skill-wanderer.com

# Domain filter — comma-separated list of domains Pathfinder searches across
NUXT_PUBLIC_PATHFINDER_DOMAINS=skill-wanderer.com,wanderings.skill-wanderer.com,dojo.skill-wanderer.com

# Chat session expiry time in minutes (default: 30)
NUXT_PUBLIC_PATHFINDER_SESSION_EXPIRY_MINUTES=30

# Chat session storage: "tab" (sessionStorage) or "browser" (localStorage with expiry)
NUXT_PUBLIC_PATHFINDER_SESSION_STORAGE=browser
