{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skill-wanderer-landing-page",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-04-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public/",
    "binding": "ASSETS"
  },
  // Newer Wrangler uploads source maps unless this is false, and ours go over
  // Cloudflare's 15 MB gzipped limit, which fails the deploy (error 10021).
  "upload_source_maps": false,
  "observability": {
    "enabled": true
  }
}
